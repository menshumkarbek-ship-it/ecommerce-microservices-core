SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Path where the Django admin is mounted (not /admin/, to keep it off of bots
# scanning for the default path). Day-to-day product/category/contact edits
# happen in-app via "Manage Products / Categories / Contacts" in the nav.
ADMIN_URL=system-console/

# Public domain the site is served from (no scheme, no trailing slash) —
# used to build the sitemap and robots.txt. Set to the real Render/custom
# domain in production.
SITE_DOMAIN=127.0.0.1:8000

# Cloudflare R2 (or any S3-compatible bucket) for uploaded product/about
# images. Leave unset locally — media then falls back to local disk. Must
# be set in production, since a host's local disk doesn't survive redeploys.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=mobile_shop_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Comma-separated origins allowed to submit forms. Defaults to the Render
# wildcard; set explicitly once a custom domain is attached, or every POST
# from it will be rejected as a CSRF failure.
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Root log level for the console handler (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
